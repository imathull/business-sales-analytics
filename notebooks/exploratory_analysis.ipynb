{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Business Sales & Performance Analytics System\n",
    "## Exploratory Data Analysis (EDA) & Insights Notebook\n",
    "\n",
    "This notebook demonstrates exploratory data analysis on the cleaned business sales dataset.\n",
    "Key sections:\n",
    "1. Data Loading & Inspection\n",
    "2. Summary Statistics & KPI Calculations\n",
    "3. Monthly Sales Trends & Seasonality\n",
    "4. Product & Category Revenue Distribution\n",
    "5. Anomaly Detection Visualizations (IQR Method)\n",
    "6. Linear Regression Sales Forecasting"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Set style for clean visual presentation\n",
    "plt.style.use('ggplot')\n",
    "%matplotlib inline\n",
    "\n",
    "# Add project root to sys.path\n",
    "BASE_DIR = Path(\"..\").resolve()\n",
    "sys.path.insert(0, str(BASE_DIR))\n",
    "\n",
    "from src.data_loader import load_raw_data\n",
    "from src.data_cleaner import clean_dataset\n",
    "from src.analytics import calculate_kpis, get_monthly_performance, detect_anomalies_iqr\n",
    "from src.forecasting import forecast_next_months"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1. Load Cleaned Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "data_path = BASE_DIR / \"data\" / \"processed\" / \"cleaned_sales_data.csv\"\n",
    "if not data_path.exists():\n",
    "    # Fallback load raw and clean on the fly\n",
    "    raw_path = BASE_DIR / \"data\" / \"raw\" / \"raw_sales_data.csv\"\n",
    "    df_raw = load_raw_data(raw_path)\n",
    "    df = clean_dataset(df_raw)\n",
    "else:\n",
    "    df = pd.read_csv(data_path)\n",
    "\n",
    "print(f\"Loaded Cleaned Sales Data: {len(df):,} records\")
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2. High-Level KPI Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "kpis = calculate_kpis(df)\n",
    "for key, val in kpis.items():\n",
    "    print(f\"{key.replace('_', ' ').title()}: {val}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 3. Monthly Sales Revenue Trend & Growth"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "monthly = get_monthly_performance(df)\n",
    "\n",
    "plt.figure(figsize=(12, 5))\n",
    "plt.plot(monthly['year_month'], monthly['total_revenue'], marker='o', color='#1F4E78', linewidth=2.5, label='Net Revenue ($)')\n",
    "plt.title('Monthly Sales Revenue Trend (2025 - 2026)', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Year-Month')\n",
    "plt.ylabel('Net Revenue ($)')\n",
    "plt.xticks(rotation=45)\n",
    "plt.grid(True, linestyle='--', alpha=0.6)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 4. Category Performance & Revenue Share"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "cat_summary = df.groupby('category')['net_sales'].sum().sort_values(ascending=True)\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "cat_summary.plot(kind='barh', color='#2F5597')\n",
    "plt.title('Total Revenue by Product Category', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Total Revenue ($)')\n",
    "plt.ylabel('Category')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 5. Anomaly Detection via IQR Method"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "anomalies_df, bounds = detect_anomalies_iqr(df, column='net_sales')\n",
    "print(f\"IQR Boundary Limits: Upper Bound = ${bounds['upper_bound']:,.2f}\")\n",
    "print(f\"Total Outlier Transactions Flagged: {len(anomalies_df)}\")\n",
    "\n",
    "# Boxplot visualization\n",
    "plt.figure(figsize=(8, 4))\n",
    "plt.boxplot(df['net_sales'], vert=False, patch_artist=True, boxprops=dict(facecolor='#8FAADC'))\n",
    "plt.title('Net Sales Distribution & Outlier Detection', fontsize=13, fontweight='bold')\n",
    "plt.xlabel('Net Sales ($)')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 6. 3-Month Sales Forecasting"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "forecast_df = forecast_next_months(monthly, periods=3)\n",
    "\n",
    "plt.figure(figsize=(12, 5))\n",
    "actual_df = forecast_df[~forecast_df['is_forecast']]\n",
    "fut_df = forecast_df[forecast_df['is_forecast']]\n",
    "\n",
    "plt.plot(actual_df['year_month'], actual_df['total_revenue'], marker='o', label='Actual Revenue', color='#1F4E78')\n",
    "plt.plot(forecast_df['year_month'], forecast_df['linear_trend'], linestyle='--', label='Linear Trendline', color='#ED7D31')\n",
    "plt.plot(fut_df['year_month'], fut_df['moving_avg_3m'], marker='s', linestyle=':', label='3M Moving Avg Forecast', color='#C00000')\n",
    "\n",
    "plt.title('Monthly Sales Revenue & 3-Month Trend Forecast', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Year-Month')\n",
    "plt.ylabel('Revenue ($)')\n",
    "plt.xticks(rotation=45)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ],
