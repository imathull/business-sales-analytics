# Database Settings
# Supports 'sqlite' for standalone zero-config local execution or 'postgresql' for production DB
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sales_analytics_db
DB_USER=postgres
DB_PASSWORD=postgres_password

# File Paths
RAW_DATA_PATH=data/raw/raw_sales_data.csv
PROCESSED_DATA_PATH=data/processed/cleaned_sales_data.csv
LOG_FILE_PATH=logs/pipeline.log
REPORT_OUTPUT_PATH=reports/business_performance_report.xlsx
